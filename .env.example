# ===== AutoVuln 环境变量示例 =====
# 复制为 .env 后按需修改（应用启动时会自动加载项目根目录或 backend/ 下的 .env）

# 安全密钥（生产必须设置！留空时应用自动生成并持久化到 backend/data/secret.key）
# SECRET_KEY=please-change-me-in-production-0123456789abcdef

# 注册邀请码（必填校验，生产环境务必修改）
# INVITE_CODE=autovuln2026

# CORS 白名单（逗号分隔；默认仅本地开发源）
# CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# 数据库（默认 SQLite 单机；生产可切 MySQL）
# DATABASE_URL=mysql+pymysql://autovuln:password@mysql:3306/autovuln

# 扫描引擎
SCAN_CONCURRENCY=4
DEFAULT_RATE_LIMIT=0.3

# OAST 带外检测回调基址
# 默认 http://127.0.0.1:8000（本地演示/内网靶场模式）
# 真实渗透：配置为目标可达的公网地址（如 https://oast.your-domain.com），
# 目标服务器需能访问该地址才能命中回调
# OAST_BASE_URL=http://127.0.0.1:8000

# 通知（高危漏洞触发）
# WEBHOOK_URL=https://example.com/webhook/autovuln
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=xxx
# SMTP_PASSWORD=xxx
# SMTP_FROM=autovuln@example.com

# 规则库在线更新源（逗号分隔 JSON 规则包 URL）
# RULE_REMOTE_URLS=https://example.com/rules/autovuln-rules.json
